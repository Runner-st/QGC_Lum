<RCC>
    <qresource prefix="/Custom/qml">
        <file alias="QGroundControl/MainWindow.qml">src/MainWindow.qml</file>
        <file alias="QGroundControl/AppSettings/ServoControlSettings.qml">src/ServoControlSettings.qml</file>
        <file alias="QGroundControl/AppSettings/SettingsPagesModel.qml">src/SettingsPagesModel.qml</file>
        <file alias="QGroundControl/AppSettings/LinksManagerSettings.qml">src/LinksManagerSettings.qml</file>
        <file alias="QGroundControl/AppSettings/LinksManagerEditDialog.qml">src/LinksManagerEditDialog.qml</file>
        <file alias="QGroundControl/AppSettings/CameraConfigEditor.qml">src/CameraConfigEditor.qml</file>
        <file alias="QGroundControl/FlightDisplay/FlyViewCustomLayer.qml">src/FlyViewCustomLayer.qml</file>
        <file alias="QGroundControl/FlightDisplay/FlyView.qml">src/FlyView.qml</file>
        <file alias="QGroundControl/FlightDisplay/FlightDisplayViewVideo.qml">src/FlightDisplayViewVideo.qml</file>
        <file alias="QGroundControl/FlightDisplay/StreamPipColumn.qml">src/StreamPipColumn.qml</file>
        <file alias="QGroundControl/FlightDisplay/StreamPipItem.qml">src/StreamPipItem.qml</file>
    </qresource>
	<qresource prefix="/res">
          <file alias="SplashScreen">res/SplashScreen.png</file>
          <file alias="QGCLogoFull.svg">res/QGCLogoFull.svg</file>
          <file alias="QGCLogoWhite.svg">res/QGCLogoWhite.svg</file>
      </qresource>
      <qresource prefix="/qmlimages">
          <file alias="Hamburger.svg">res/Images/Hamburger.svg</file>
      </qresource>
</RCC>